<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /leveleinde/

  # Don't rewrite real files or directories (JS, CSS, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrite everything else to index.html so the SPA router handles it
  RewriteRule ^ index.html [L]
</IfModule>
