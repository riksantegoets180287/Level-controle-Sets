      "set_id": "d6095080-9180-43e2-be4c-ff49570e9ff1",
      "card_a_text": "Desinformatie (Fake News)",
      "card_b_text": "Opzettelijk verspreide onware berichten om mensen bang te maken of te beïnvloeden.",
