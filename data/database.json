    },
    {
      "id": "40539dcb-5e1f-471c-91ac-c0751320578c",
      "set_id": "2ce9b90b-e91b-47b1-a334-b5ba3173cc7b",
      "card_a_text": "Tweestapsverificatie (2FA)",
      "card_b_text": "Extra beveiliging naast je wachtwoord, zoals een eenmalige code via sms of app.",
      "sort_order": 2,
      "created_at": "2026-09-14T11:54:16.575Z",
      "updated_at": "2026-09-14T11:54:16.575Z"
    },
