      "set_id": "2ce9b90b-e91b-47b1-a334-b5ba3173cc7b",
      "card_a_text": "Ransomware (Gijzelsoftware)",
      "card_b_text": "Kwaadaardig computerprogramma dat al je bestanden blokkeert en losgeld eist.",
